# Copy this file to ".env" and fill in the values. Never commit .env.
# On GitHub, the same names go in Settings > Secrets and variables > Actions.

# --- Shortcut (required) ---
# Shortcut > Settings (your avatar) > Your Account > API Tokens
SHORTCUT_API_TOKEN=

# --- Email (required to send) ---
# brevo | gmail | outlook | smtp
EMAIL_PROVIDER=brevo
# The account that sends the report and answers questions
EMAIL_USER=
# Gmail: a 16-character App Password (NOT your normal password). See README.
EMAIL_PASSWORD=
# Sender address people see (Brevo: your verified sender email)
EMAIL_FROM=
EMAIL_FROM_NAME=Shortcut Daily Report
# Who gets the report, comma-separated
REPORT_RECIPIENTS=
REPORT_SUBJECT=Shortcut Daily Report

# Only needed when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
IMAP_HOST=

# --- Customer priority (fill any of these; a ticket matching ANY counts) ---
# Run "npm run list-config" to see the names in your workspace.
CUSTOMER_LABELS=CustomerIssue
CUSTOMER_STATES=Customer Priority
CUSTOMER_PRIORITY_VALUES=
CUSTOMER_STORY_TYPES=
CUSTOMER_TEAMS=

# --- Optional ---
# If several teams run sprints at the same time, the team whose sprint to report on
ITERATION_TEAM=
# Days before "in progress with no PR" and "PR open" are flagged
FLAG_STALE_DAYS=3
# Extra statuses that count as finished (default: only Shortcut "done" statuses like Completed)
DONE_STATES=
# Statuses where a merged PR is normal, so it isn't flagged (e.g. Ready in QA,Completed in QA)
MERGED_OK_STATES=
# Who may email questions to the assistant (addresses or "@domain.com").
# Empty = the report recipients.
CHAT_ALLOWED_SENDERS=
# Address people write questions to. Empty = EMAIL_USER with "+shortcut" (Gmail).
CHAT_ADDRESS=
